# ~/.config/sway/output

# ------------------------------
# VARIABLE PARA EL WALLPAPER
# ------------------------------
set $wallpaper /home/dariobf/.dariobf/wallpapers/Inner_You2.jpg
set $wallpaper_color #000000

# ------------------------------
# CONFIGURACIÓN DE MONITORES
# ------------------------------

# Pantalla del portátil
output eDP-1 resolution 2256x1504 position 0,0 scale 1.66

# Monitor principal
output DP-6 resolution 3840x2160 position 2256,0 scale 1.0

# Monitor secundario
output DP-4 resolution 1920x1080 position 0,1504 scale 1.0

# Monitor pequeño adicional
output DP-5 resolution 1920x1080 position 3840,0 scale 1.0

output * background $wallpaper fill
