### Variables
#
# Logo key. Use Mod1 for Alt.
set $mod Mod4

# Home row direction keys, like vim
set $left h
set $down j
set $up k
set $right l

# Your preferred terminal emulator
set $term kitty

# Your preferred application launcher
# set $menu wmenu-run
set $menu rofi -show drun -show-icons

include /etc/sway/config-vars.d/*
include input
include output
include bindings
include looknfeel
include windows

