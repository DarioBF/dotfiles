########################################
# FLOATING TUI APPS
########################################

for_window [app_id="^(tui-calcure|tui-bluetuith|tui-impala|tui-fastfetch|tui-wiremix|TUI.float|imv|mpv)$"] floating enable, move position center, resize set 875 600


########################################
# BITWARDEN POPUP
########################################

for_window [title="Bitwarden Password Manager"] \
    floating enable, move position center


########################################
# FILE PICKERS / SAVE DIALOGS
########################################

for_window [app_id="^(xdg-desktop-portal-gtk|sublime_text|DesktopEditors|org.gnome.Nautilus)$" \
            title="^(Open.*Files?|Open [Ff]older.*|Save.*Files?|Save.*As|Save|All Files|.*wants to (open|save).*|[Cc]hoose.*)$"] \
    floating enable, move position center


########################################
# GNOME CALCULATOR
########################################

for_window [app_id="org.gnome.Calculator"] floating enable


########################################
# PLEXAMP
########################################

for_window [title="Plexamp"] floating enable, move position center, resize set 330 560


########################################
# FIREFOX BITWARDEN EXTENSION
########################################

for_window [class="firefox" title="Extension: \(Bitwarden Password Manager\)"] floating enable, move position center

