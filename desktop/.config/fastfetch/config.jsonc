{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/master/doc/json_schema.json",
  "logo": {
    "type": "kitty",
    "source": "~/.config/fastfetch/cachyos_logo.png",
    "width": 35,
    "height": 15,
    "preserveAspectRatio": true,
    "padding": {
      "top": 3,
      "left": 2,
      "right": 4,
    },
  },
  "display": {
    "separator": " ",
    "color": {
      "keys": "38;2;170;255;255",
      "title": "38;2;76;87;127",
      "output": "38;2;255;255;255",
    },
    "size": {
      "binaryPrefix": "si",
    },
  },
  "modules": [
    "title",
    // ============================================
    //  HARDWARE CARD (ZIG YELLOW)
    // ============================================
    {
      "type": "custom",
      "format": "{#title}┌── {#keys} Hardware {#title}────────────────────────────────────┐",
    },
    {
      "type": "host",
      "key": "│ ",
    },
    {
      "type": "cpu",
      "key": "│ ├─ ",
      "format": "{1}",
    },
    {
      "type": "gpu",
      "key": "│ ├─ ",
    },
    {
      "type": "display",
      "key": "│ ├─ 󰍹",
    },
    {
      "type": "memory",
      "key": "│ ├─ ",
    },
    {
      "type": "disk",
      "key": "│ ├─ ",
      "folders": "/",
    },
    {
      "type": "battery",
      "key": "│ └─ ",
    },
    {
      "type": "custom",
      "format": "{#title}└──────────────────────────────────────────────────┘",
    },
    // ============================================
    //  SOFTWARE CARD (RUST ORANGE)
    // ============================================
    {
      "type": "custom",
      "format": "{#title}┌── {#keys} Software {#title}──────────────┐",
    },
    {
      "type": "os",
      "key": "│ ",
    },
    {
      "type": "kernel",
      "key": "│ ├─ ",
    },
    {
      "type": "uptime",
      "key": "│ ├─ ",
    },
    {
      "type": "command",
      "key": "│ │ └─ OS Age: ",
      "text": "birth_install=$(stat -c %W /); current=$(date +%s); time_progression=$((current - birth_install)); days_difference=$((time_progression / 86400)); echo $days_difference days"
    },
    {
      "type": "packages",
      "key": "│ ├─ ",
    },
    {
      "type": "shell",
      "key": "│ ├─ ",
    },
    {
      "type": "terminal",
      "key": "│ └─ ",
    },
    {
      "type": "custom",
      "format": "{#title}└────────────────────────────┘",
    },
    // ============================================
    //  DESKTOP CARD (ZIG YELLOW)
    // ============================================
    {
      "type": "custom",
      "format": "{#title}┌── {#keys} Desktop {#title}──────────────┐",
    },
    {
      "type": "de",
      "key": "│ ",
    },
    {
      "type": "wm",
      "key": "│ └─ ",
    },
    {
      "type": "wmtheme",
      "key": "│ ├─ ",
    },
    {
      "type": "theme",
      "key": "│ └─ ",
      "format": "{1}",
    },
    {
      "type": "custom",
      "format": "{#title}└───────────────────────────┘",
    },
    {
      "type": "colors",
      "symbol": "square",
      "paddingLeft": 2,
    },
  ],
}
