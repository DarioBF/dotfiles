{
  "layer": "top",
  "position": "top",
  "spacing": 0,
  "height": 26,
  "modules-left": [
    "hyprland/workspaces"
  ],
  "modules-center": [
    "clock"
  ],
  "modules-right": [
    "temperature",
    "bluetooth",
    "network",
    "pulseaudio",
    "cpu",
    "battery"
  ],
  "hyprland/workspaces": {
    "on-click": "activate",
    "format": "{icon}",
    "format-icons": {
      "default": "",
      "1": "󰣇",
      "2": "",
      "3": "",
      "4": "󰏘",
      "5": "󰭹",
      "6": "󱣛",
      "7": "󱣛",
      "8": "󱣛",
      "active": "󱓻"
    },
    "persistent-workspaces": {
      "eDP-1": [
        8
      ]
    }
  },
  "temperature": {
    "hwmon-path": "/home/dariobf/.local/devices/cpu/temp1_input",
    "critical-threshold": 80,
    "interval": 2,
    "format": " {temperatureC}°C",
    "on-click": "kitty -e btop"
  },
  "cpu": {
    "interval": 5,
    "format": "󰍛",
    "on-click": "kitty -e btop"
  },
  "clock": {
    "format": "{:%A %d, %H:%M}",
    "tooltip": false,
    "on-click": "exec setsid uwsm app -- kitty --class=tui-calcure -o font.size=9 -e bash -c 'calcure; read -n 1 -s'"
  },
  "network": {
    "format-icons": [
      "󰤯",
      "󰤟",
      "󰤢",
      "󰤥",
      "󰤨"
    ],
    "format": "{icon}",
    "format-wifi": "{icon}",
    "format-ethernet": "󰀂",
    "format-disconnected": "󰖪",
    "tooltip-format-wifi": "{essid} ({frequency} GHz)\n⇣{bandwidthDownBytes}  ⇡{bandwidthUpBytes}",
    "tooltip-format-ethernet": "⇣{bandwidthDownBytes}  ⇡{bandwidthUpBytes}",
    "tooltip-format-disconnected": "Disconnected",
    "interval": 3,
    "nospacing": 1,
    "on-click": "exec setsid uwsm app -- kitty --class=tui-impala -o font.size=9 -e bash -c 'impala; read -n 1 -s'"
  },
  "battery": {
    "format": "{capacity}% {icon}",
    "format-discharging": "{capacity}% {icon}",
    "format-charging": "{icon}",
    "format-plugged": "",
    "format-icons": {
      "charging": [
        "󰢜",
        "󰂆",
        "󰂇",
        "󰂈",
        "󰢝",
        "󰂉",
        "󰢞",
        "󰂊",
        "󰂋",
        "󰂅"
      ],
      "default": [
        "󰁺",
        "󰁻",
        "󰁼",
        "󰁽",
        "󰁾",
        "󰁿",
        "󰂀",
        "󰂁",
        "󰂂",
        "󰁹"
      ]
    },
    "format-full": "Charged ",
    "tooltip-format-discharging": "{power:>1.0f}W↓ {capacity}%",
    "tooltip-format-charging": "{power:>1.0f}W↑ {capacity}%",
    "interval": 5,
    "states": {
      "warning": 20,
      "critical": 10
    }
  },
  "bluetooth": {
    "format": "",
    "format-disabled": "󰂲",
    "format-connected": "",
    "tooltip-format": "Devices connected: {num_connections}",
    "on-click": "exec setsid uwsm app -- kitty --class=tui-bluetuith -o font.size=9 -e bash -c 'bluetuith; read -n 1 -s'"
  },
  "pulseaudio": {
    "format": "{icon} {volume}%",
    "format-icons": {
      "default": [
        "󰕿",
        "󰖀",
        "󰕾"
      ]
    },
    "format-muted": "󰝟",
    "scroll-step": 5,
    "on-scroll-up": "wpctl set-volume -l 1 @DEFAULT_AUDIO_SINK@ 5%+",
    "on-scroll-down": "wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%-",
    "on-click": "exec setsid uwsm app -- kitty --class=tui-wiremix -o font.size=9 -e bash -c 'wiremix; read -n 1 -s'",
    "tooltip-format": "Playing at {volume}%",
    "on-click-right": "pamixer -t",
    "ignored-sinks": [
      "Easy Effects Sink"
    ]
  }
}
